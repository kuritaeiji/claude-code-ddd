{
  "permissions": {
    "allow": [
      "Read(//home/kuritaeiji/claude-code/**)",
      "Write(//home/kuritaeiji/claude-code/**)",
      "Edit(//home/kuritaeiji/claude-code/**)",
      "Bash(make *)",
      "Bash(date *)",
      "Bash(mkdir *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(go *)",
      "Bash(golangci-lint *)",
      "Bash(cd *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Agent(*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; echo \"$f\" | grep -q '\\.md$' && npx prettier --write \"$f\"; } 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; echo \"$f\" | grep -q '\\.go$' && gofmt -w \"$f\"; } 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/kuritaeiji/claude-code/backend && make vet",
            "timeout": 60,
            "statusMessage": "go vet 実行中..."
          }
        ]
      }
    ]
  }
}

