{
  "permissions": {
    "allow": [
      "Read(//home/kuritaeiji/claude-code/**)",
      "Write(//home/kuritaeiji/claude-code/**)",
      "Edit(//home/kuritaeiji/claude-code/**)",
      "Bash(make *)",
      "Bash(date *)",
      "Bash(mkdir *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(go *)",
      "Bash(echo *)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(cd *)",
      "Bash(sort *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(set *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["playwright"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; echo \"$f\" | grep -qE '\\.(md|json|yaml|yml)$' && prettier --write \"$f\"; } 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; echo \"$f\" | grep -q '\\.go$' && gofmt -w \"$f\"; } 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/kuritaeiji/claude-code/backend && make build && make vet",
            "timeout": 60,
            "statusMessage": "make build + make vet 実行中..."
          }
        ]
      }
    ]
  }
}
