# アプリが読むすべての環境変数の唯一の source of truth（テンプレート・コミット対象）。
# 実値は .env.local にコピーして編集する: cp .env.example .env.local

# PostgreSQL 接続情報
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=taskdb

# HTTP サーバー
PORT=8080

# 翻訳ファイルのディレクトリ（backend/ からの相対パス）
LOCALES_DIR=locales
